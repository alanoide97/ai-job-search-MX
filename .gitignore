.agents/**/node_modules/
.agents/**/*.log
.agents/usage/

# Brainstorm mockups (superpowers visual companion) - never ship
.superpowers/

# Scratch & SuccessFactors automation state (sessions, credentials, screenshots)
scratch/
tools/sf_toolkit/state/

