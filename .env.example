# Candidate Profile & Compensation Configuration
# Copy this file to .env and customize with your personal details.
# .env is ignored by Git and will never be committed.

# Candidate Profile
CANDIDATE_NAME="Jane Doe"
CANDIDATE_FIRST_NAME="Jane"
CANDIDATE_LAST_NAME="Doe"
CANDIDATE_EMAIL="jane.doe@example.com"
CANDIDATE_PHONE="+1 555 123 4567"
CANDIDATE_PHONE_DIGITS="5551234567"
CANDIDATE_LOCATION="City, State, Country"
CANDIDATE_CITY="City"
CANDIDATE_STATE="State"
CANDIDATE_POSTAL_CODE="12345"
CANDIDATE_LINKEDIN="https://www.linkedin.com/in/janedoe"
CANDIDATE_ENGLISH_LEVEL="Fluent / Professional Working Proficiency (C1)"
CANDIDATE_EXPERIENCE_YEARS="5"
CANDIDATE_AVAILABILITY="Immediate"
CANDIDATE_HEADLINE="Professional Title | Specialization"
CANDIDATE_SUMMARY="Experienced professional specializing in domain competencies, workflow operations, and results delivery."

# Compensation Defaults (Used if not defined in candidate JSON profile)
SALARY_FLOOR_MXN="10000"
SALARY_EXPECTED_ENTRY_MXN="18000"
SALARY_EXPECTED_MID_MXN="24000"
SALARY_EXPECTED_SENIOR_MXN="32000"

# Optional Pilot / Testing Automation Targets
PILOT_TARGET_URL="https://mx.indeed.com/viewjob?jk=0d50c6348b2822b8"
